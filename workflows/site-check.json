      },
      "id": "a1000000-0000-4000-8000-000000000011",
      "name": "PageSpeed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        220
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// One event out of everything the checks found. A check that failed is part of the report\n// (its status or error), not a reason to send none.\nconst result = $('Result').first().json;\n\n// Only records of the type asked for: an answer for a CNAME'd name also lists the CNAME.\nconst answers = (node, type) =>\n  ($(node).first().json.body?.Answer ?? []).filter((a) => a.type === type).map((a) => a.data);\n\nconst rdapResponse = $('RDAP').first().json;\nconst rdap = rdapResponse.body ?? {};\nconst rdapEvent = (action) =>\n  (rdap.events ?? []).find((e) => e.eventAction === action)?.eventDate ?? '';\nconst registrar = (rdap.entities ?? []).find((e) => (e.roles ?? []).includes('registrar'));\nconst registrarName = (registrar?.vcardArray?.[1] ?? []).find((f) => f[0] === 'fn')?.[3] ?? '';\n\nconst pagespeedResponse = $('PageSpeed').first().json;\nconst pagespeed = pagespeedResponse.body ?? {};\nconst score = pagespeed.lighthouseResult?.categories?.performance?.score;\n\nreturn [\n  {\n    json: {\n      event_name: 'site_check_reported',\n      user_id: result.user_id,\n      cycle_key: result.cycle_key,\n      domain: result.domain,\n      status: result.status,\n      ok: result.ok,\n      dns: {\n        a: answers('DNS A', 1),\n        aaaa: answers('DNS AAAA', 28),\n        ns: answers('DNS NS', 2),\n      },\n      rdap: {\n        status: rdapResponse.statusCode ?? 0,\n        registrar: registrarName,\n        registered_at: rdapEvent('registration'),\n        expires_at: rdapEvent('expiration'),\n      },\n      certificate: $('Certificate').first().json,\n      pagespeed: {\n        status: pagespeedResponse.statusCode ?? 0,\n        performance: score == null ? null : Math.round(score * 100),\n        error: pagespeed.error?.message ?? '',\n      },\n    },\n  },\n];\n"
      },
      "id": "a1000000-0000-4000-8000-000000000012",
