    {
      "parameters": {
        "jsCode": "// The certificate the site serves on 443, whoever issued it. Needs `tls`, which the image\n// allows with NODE_FUNCTION_ALLOW_BUILTIN=tls; without that this node reports an error\n// and the rest of the report still goes out.\nconst tls = require('tls');\nconst domain = $('Result').first().json.domain;\n\nconst certificate = await new Promise((resolve) => {\n  const socket = tls.connect(\n    { host: domain, port: 443, servername: domain, rejectUnauthorized: false, timeout: 5000 },\n    () => {\n      const c = socket.getPeerCertificate();\n      const expires = new Date(c.valid_to);\n      resolve({\n        subject: c.subject?.CN ?? '',\n        issuer: c.issuer?.O ?? c.issuer?.CN ?? '',\n        valid_from: new Date(c.valid_from).toISOString(),\n        expires_at: expires.toISOString(),\n        days_left: Math.floor((expires - Date.now()) / 86400000),\n        trusted: socket.authorized,\n        error: socket.authorized ? '' : String(socket.authorizationError ?? ''),\n      });\n      socket.end();\n    },\n  );\n  socket.on('error', (e) => resolve({ error: e.message }));\n  socket.on('timeout', () => {\n    socket.destroy();\n    resolve({ error: 'timed out' });\n  });\n});\n\nreturn [{ json: certificate }];\n"
      },
      "id": "a1000000-0000-4000-8000-000000000010",
      "name": "Certificate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        220
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://www.googleapis.com/pagespeedonline/v5/runPagespeed?url={{ encodeURIComponent('https://' + $('Result').first().json.domain) }}&strategy=mobile&category=performance",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
